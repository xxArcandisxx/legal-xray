OPENAI_API_KEY=your-api-key-here

# Optional Supabase accounts and long-term document storage
SUPABASE_URL=https://your-project.supabase.co
# New Supabase names:
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy names also work: SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=legal-documents

